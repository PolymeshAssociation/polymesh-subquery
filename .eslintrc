{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-empty-function": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@polkadot/api-augment",
            "message": "Reintroducing @polkadot/api-augment (the generic Substrate kitchensink augmentation) alongside polymesh-types silently decides which chain ~161 shared members describe, by import order. Use `import '@polkadot/types-augment'` for the runtime type registry instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/**/*.ts"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression[callee.property.name='toU8a']",
            "message": "Inside SubQuery's sandbox, @polkadot/util misreads the host's Uint8Array as text. Use codecBytes (src/utils/bytes.ts), or disable this with a comment where the bytes go straight back to the host's API."
          },
          {
            "selector": "NewExpression[callee.name='TextDecoder']",
            "message": "Inside SubQuery's sandbox, the host's TextDecoder rejects the sandbox's typed arrays. Decode with utf8Text (src/utils/bytes.ts)."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@polkadot/api-augment",
                "message": "Reintroducing @polkadot/api-augment (the generic Substrate kitchensink augmentation) alongside polymesh-types silently decides which chain ~161 shared members describe, by import order. Use `import '@polkadot/types-augment'` for the runtime type registry instead."
              },
              {
                "name": "@polkadot/util",
                "importNames": [
                  "u8aToString",
                  "hexToString"
                ],
                "message": "Inside SubQuery's sandbox, this decodes with the host's TextDecoder, which rejects the sandbox's typed arrays. Decode with utf8Text (src/utils/bytes.ts), or the codec's own toUtf8()."
              },
              {
                "name": "@polkadot/x-textdecoder",
                "message": "Inside SubQuery's sandbox, this decodes with the host's TextDecoder, which rejects the sandbox's typed arrays. Decode with utf8Text (src/utils/bytes.ts), or the codec's own toUtf8()."
              }
            ]
          }
        ]
      }
    }
  ]
}
